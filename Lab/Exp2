import matplotlib.pyplot as plt

attributes = [
    "Sky", "AirTemp", "Humidity",
    "Wind", "Water", "Forecast"
]

S = ["Sunny", "Warm", "?", "Strong", "?", "?"]
G = ["?", "?", "?", "?", "?", "?"]

plt.figure(figsize=(9, 5))

plt.plot(
    attributes,
    range(1, 7),
    marker="o",
    label="Specific Boundary S"
)

plt.plot(
    attributes,
    range(1, 7),
    marker="x",
    label="General Boundary G"
)

plt.xlabel("Attributes")
plt.ylabel("Hypothesis Position")
plt.title("Candidate-Elimination Boundaries")

plt.legend()
plt.grid()

plt.show()
